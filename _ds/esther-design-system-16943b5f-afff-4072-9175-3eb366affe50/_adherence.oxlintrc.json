{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/code/**",
              "components/compare/**",
              "components/interactive/**",
              "components/layout/**",
              "components/misc/**",
              "components/navigation/**",
              "components/quotes/**",
              "components/text-fx/**",
              "components/travel/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fraunces|Caveat|Noto Serif SC|Noto Sans SC|Fira Code|Bangers))/i]",
        "message": "Font not provided by the design system. Available: Fraunces, Caveat, Noto Serif SC, Noto Sans SC, Fira Code, Bangers."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItemDef'] > JSXAttribute > JSXIdentifier[name!=/^(?:step|title|content|key|ref|className|style|children)$/]",
        "message": "<AccordionItemDef> doesn't accept that prop. Declared props: step, title, content."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrbitLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|style|key|ref|className|style|children)$/]",
        "message": "<OrbitLabel> doesn't accept that prop. Declared props: label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|title|author|verdict|tags|onClick|className|style|key|ref|className|style|children)$/]",
        "message": "<BookCard> doesn't accept that prop. Declared props: category, title, author, verdict, tags, onClick, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|coolMode|href|onClick|className|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, coolMode, href, onClick, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:blue|yellow|outline|pill)$/]",
        "message": "<Button> variant must be one of 'blue' | 'yellow' | 'outline' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|title|desc|number|tagLabel|icon|emoji|dashedLabel|meta|romanIndex|accent|className|style|key|ref|className|style|children)$/]",
